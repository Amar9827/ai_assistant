# AI Voice Assistant Configuration
# Copy this file to .env and customize for your system

# STT Provider: "groq" (cloud Whisper large-v3-turbo) or "local" (faster-whisper)
# Groq gives best accuracy (~2.2% WER) at sub-500ms latency, zero CPU load
# Uses same GROQ_API_KEY as LLM — falls back to local on failure
STT_PROVIDER=groq

# Whisper Configuration (local fallback)
# Options: tiny, base, small, medium, large
WHISPER_MODEL=small
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=int8

# LLM Provider: "ollama" (local) or "groq" (cloud)
# Groq gives faster, smarter responses via cloud inference
LLM_PROVIDER=ollama

# Ollama Configuration (local LLM)
# Install models with: ollama pull <model-name>
OLLAMA_MODEL=llama3.2:3b
OLLAMA_HOST=http://localhost:11434
OLLAMA_TEMPERATURE=0.7

# Groq Configuration (cloud LLM — fast inference)
# Get free API key at: https://console.groq.com
# Set LLM_PROVIDER=groq to use
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Piper TTS Configuration (Text-to-Speech)
# Download voices from: https://github.com/rhasspy/piper/blob/master/VOICES.md
# en_GB-alan-medium: single British male voice (JARVIS-like, refined RP accent)
# en_GB-vctk-medium: 109 speakers (set PIPER_SPEAKER 0-108)
PIPER_VOICE=en_GB-alan-medium
PIPER_SPEAKER=0
PIPER_LENGTH_SCALE=0.85

# Audio Settings
SAMPLE_RATE=16000

# Security
CORS_ORIGINS=http://localhost:5173
MAX_AUDIO_MB=10
